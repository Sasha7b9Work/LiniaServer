/* common.css
----------------------------------------------- */

body{
	background: url(../images/bg_print.gif) top center;
	background-repeat: repeat-x;
	background-color: #FFFFFF;
}

a:link,
a:visited {
	text-decoration: underline;
	color: #000000;
}

img {
	border: 0;
}

#wrapper {
	float: none !important;
	width: auto;
	margin: 0 !important;
