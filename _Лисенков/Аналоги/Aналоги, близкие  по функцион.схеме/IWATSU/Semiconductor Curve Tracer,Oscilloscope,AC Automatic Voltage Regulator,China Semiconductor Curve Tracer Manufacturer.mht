#etw_map{width:100%;margin:0 auto; text-align:left;}
#etw_map a{color:#0000cc;height:20px; width:100%; text-decoration:underline; display:block;  margin-top:5px;font-weight:bold;}
#etw_map a:hover{ text-decoration:none;}
#etw_map .name{width:99% !important;_width:100%;background:#ddd;  margin-top:4px; height:20px; line-height:20px; display:block; margin-bottom:4px;}
#etw_map .name a{color:#0000cc; margin:0;  font-weight:bold; text-decoration:none; padding-left:4px;}
#etw_map .name a:hover{text-decoration:underline}

#etw_map .name1{width:99% !important;_width:100%; margin-top:4px; line-height:20px; display:block; margin-bottom:4px;}
#etw_map .name1 a{color:#0000cc; margin:0; text-decoration:none; padding-left:4px;}
#etw_map .name1 a:hover{text-decoration:underline}
#etw_map .aa{ padding-left:10px;}
#etw_map .aa a{ font-weight:normal;}
#etw_map .bb{ padding-left:15px;}
#etw_map .bb a{ font-weight:normal;}

.etw_pic{ width:100%; height:auto; float:left; margin:5px 0;}
.etw_pic img{ border:1px solid #ccc; padding:1px; float:left; margin-right:5px;}
.etw_pro{ width:100%; height:auto; float:left;}
.etw_pro a{ color:#333; font-weight:bold; font-size:14px;}
.etw_pro a:hover{ text-decoration:underline;}
.etw_pro1{ width:100%; height:auto; float:left;}
.etw_pro1 a{ color:#1D387A; font-weight:bold; font-size:14px;}
.etw_pro1 a:hover{ text-decoration:underline;}
.etw_pro2{ width:100%; height:auto; float:left; border-bottom:1px dotted #ccc;}
.etw_pro2 a{ color:#333; font-weight:bold; font-size:14px;}
.etw_pro2 a:hover{ text-decoration:underline;}
.etw_img{ border:1px solid #ccc; padding:1px;}

